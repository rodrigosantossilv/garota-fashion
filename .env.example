# ============================================================
#  Garota Fashion — variáveis de ambiente
#  Copie este arquivo para ".env" (desenvolvimento) e configure
#  as mesmas variáveis no painel da Vercel (produção).
#  NUNCA faça commit do arquivo .env.
# ============================================================

# Segredo usado para assinar o cookie de sessão do painel.
# Obrigatório. Use pelo menos 32 caracteres aleatórios.
# Para gerar um:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_SEGREDO=

# Onde os dados são gravados:
#   local  -> grava direto nos arquivos da pasta (use no seu computador)
#   github -> grava no repositório pelo GitHub (use na Vercel)
# Se não for informado: "github" quando GITHUB_TOKEN existir, senão "local".
ARMAZENAMENTO=local

# --- Só para ARMAZENAMENTO=github ---------------------------
# Token "fine-grained" do GitHub com permissão "Contents: Read and write"
# APENAS neste repositório.
GITHUB_TOKEN=
# Repositório no formato dono/nome
GITHUB_REPO=seu-usuario/seu-repositorio-privado
# Branch que a Vercel publica (o branch de produção)
GITHUB_BRANCH=main

# --- Primeiro acesso ao painel sem usar o terminal (opcional) ---
# Enquanto NÃO existir nenhum administrador, entrar no /painel com este e-mail e
# senha cria a conta (só o hash é guardado). Depois do primeiro login, apague
# estas duas variáveis: elas passam a ser ignoradas.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=

# Custo do bcrypt (opcional, padrão 12). Não use menos que 10 em produção.
BCRYPT_CUSTO=12
